      },
      "source": [
        "## Setup\n",
        "**[BOTH - Training & Testing]**\n",
        "\n",
        "\n",
        "The datasets and checkpoints are stored in a shared Google Drive folder. If you are using colab, simply add the shared folder as a shortcut to \"My Drive\" before running the setup cell. If you are running it locally, datasets will be automatically downloaded if not present, while checkpoints can either be downloaded from the shared folder or generated by training the models yourself."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 1,
      "id": "d80b1852",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "d80b1852",
        "outputId": "e3302e74-6239-48f5-920a-4d5d1093b783"
      },
      "outputs": [],
      "source": [
        "import os\n",
        "import sys\n",
        "\n",
        "try:\n",
        "    import google.colab\n",
        "    IN_COLAB = True\n",
        "except:\n",
        "    IN_COLAB = False\n",
        "\n",
        "print(f\"Running in colab: {IN_COLAB}\")\n",
        "\n",
        "if IN_COLAB: #running in colab\n",
        "\n",
        "    # Check if already cloned\n",
        "    if not os.path.exists('/content/6D-pose-estimation'):\n",
        "        print(\"Cloning repository...\")\n",
        "        !git clone -b baseline-rgb-geometric-depth https://github.com/luigiaceto/6D-pose-estimation.git\n",
        "    else:\n",
        "        print(\"Repository already cloned, pulling latest changes...\")\n",
        "        %cd /content/6D-pose-estimation\n",
        "        !git pull\n",
        "        %cd /content\n",
        "\n",
        "    # Navigate to project directory\n",
        "    %cd /content/6D-pose-estimation\n",
        "\n",
        "    # Install dependencies\n",
        "    print(\"Installing dependencies...\")\n",
        "    !pip install -q -r requirements.txt\n",
        "\n",
        "    # Mount Google Drive FIRST\n",
        "    from google.colab import drive\n",
        "    if not os.path.exists('/content/drive'):\n",
        "        drive.mount('/content/drive')\n",
        "    else:\n",
        "        print(\"Drive already mounted\")\n",
        "\n",
        "    # REMOVE old symlinks to avoid recursion\n",
        "    !rm -rf ./datasets ./checkpoints\n",
        "\n",
        "    # Create fresh symbolic links\n",
        "    !ln -s /content/drive/MyDrive/6D-pose-estimation/datasets ./datasets\n",
        "    !ln -s /content/drive/MyDrive/6D-pose-estimation/checkpoints ./checkpoints\n",
        "\n",
        "    print(\"\\n Symlink Datasets:\")\n",
        "    !ls ./datasets/\n",
        "    print(\"\\n Symlink Checkpoints:\")\n",
        "    !ls ./checkpoints/\n",
        "\n",
        "else: #running locally\n",
        "\n",
        "    dataset_files = [f for f in os.listdir('./datasets') if f != '.gitkeep']\n",
        "\n",
        "    if len(dataset_files) == 0:\n",
        "        print(\"Downloading datasets from Google Drive...\")\n",
        "        !mkdir -p datasets/linemod\n",
        "        %cd datasets/linemod\n",
        "        !gdown --folder \"https://drive.google.com/drive/folders/1xEHOOLrkLD814mA9cJqM2kZ-vn35Zr7s?usp=drive_link\"\n",
        "        %cd DenseFusion\n",
        "        !unzip Linemod_preprocessed.zip\n",
        "        !rm Linemod_preprocessed.zip\n",
        "        !rm -f trained_checkpoints.zip\n",
        "        %cd ../../../\n",
        "        print(\"Datasets downloaded!\")\n",
        "    else:\n",
        "        print(f\"Datasets already present: {len(dataset_files)} items\")\n",
        "\n",
        "    # Check checkpoints\n",
        "    checkpoint_files = [f for f in os.listdir('./checkpoints') if f != '.gitkeep']\n",
        "    if len(checkpoint_files) == 0:\n",
        "        print(\"\\nNo checkpoints found!\")\n",
        "        print(\"   Options:\")\n",
        "        print(\"   1. Download from Google Drive (team members)\")\n",
        "        print(\"   2. Train models yourself (see training cells below)\")\n",
        "    else:\n",
        "        print(f\"Checkpoints found: {checkpoint_files}\")"
      ]
    },
